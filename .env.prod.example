# ==============================================================================
# Telegram Personal Finance Assistant (Hermes) - Production Environment Variables
# ==============================================================================
# Copy this file to .env on your production host and configure all settings.
# Ensure that file permissions on the production .env file are set securely (e.g., chmod 600 .env).

# ------------------------------------------------------------------------------
# 1. Database Configuration
# ------------------------------------------------------------------------------
# In production, use a strong, randomly generated database password.
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=YOUR_STRONG_SECURE_PASSWORD_HERE
DB_NAME=finance_db
TZ=Asia/Jakarta

# ------------------------------------------------------------------------------
# 2. Telegram Bot Configuration
# ------------------------------------------------------------------------------
# Create a production bot with BotFather on Telegram and insert the token here.
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
BOT_PORT=8080

# ------------------------------------------------------------------------------
# 3. AI Service Configuration
# ------------------------------------------------------------------------------
AI_SERVICE_HOST=ai-service
AI_SERVICE_PORT=8000
AI_SERVICE_URL=http://ai-service:8000

# LLM Configuration Option A: Google Gemini API (Default setup)
# Get a key from Google AI Studio.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-1.5-flash

# LLM Configuration Option B: Custom OpenAI-compatible API
# Uncomment and fill these if you use an alternative LLM provider instead of Gemini.
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o
# LLM_API_KEY=YOUR_OPENAI_API_KEY_HERE
